# API base URL (optional - defaults to /api which uses Vite proxy in dev)
# For production, set to your backend URL e.g. https://api.yoursite.com/api
VITE_API_URL=/api

# Google OAuth - same Client ID as backend (Web application type in Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
